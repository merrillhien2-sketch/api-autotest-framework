# ====================================================================
# 接口自动化测试框架 - 环境变量示例
# 使用方式：复制本文件为 .env 并按需修改（请勿提交真实账号/密钥）
#   cp .env.example .env
# ====================================================================

# 被测服务基础地址
# 说明：conftest 启动内置 Mock 服务时会使用随机端口并覆盖该值，
#       此处仅作为占位。对接真实被测服务时填写真实地址即可。
BASE_URL=http://127.0.0.1:8000

# 请求统一超时时间（秒）
TIMEOUT=10

# HTTP 重试配置（仅对幂等请求 GET/PUT/DELETE/HEAD/OPTIONS 生效）
MAX_RETRIES=2
RETRY_BACKOFF=0.5

# 测试账号（占位，请替换为被测服务的真实测试账号）
TEST_USERNAME=admin
TEST_PASSWORD=123456

# JWT 鉴权配置（仅被内置 Mock 服务使用，请勿使用真实密钥）
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=logs
